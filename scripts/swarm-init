#!/bin/bash
# swarm-init — Create a new project from the starter template and optionally launch a swarm.
#
# Usage:
#   swarm-init <project-name> [--workers N] [--start]
#
# Examples:
#   swarm-init my-app                    # Create project only
#   swarm-init my-app --start            # Create project and launch swarm (1 lead + 2 workers)
#   swarm-init my-app --workers 4 --start  # Create project and launch with 4 workers

set -euo pipefail

TEMPLATE_REPO="$HOME/code/claude_starting_repo_setup"
CODE_DIR="$HOME/code"
WORKERS=2
START=false
PUBLIC=false
IOS=false
TRACKER=bd

usage() {
    echo "Usage: swarm-init <project-name> [--workers N] [--start]"
    echo ""
    echo "Creates a new project from the starter template."
    echo ""
    echo "Options:"
    echo "  --workers N   Number of worker agents (default: 2)"
    echo "  --start       Launch the swarm immediately after creation"
    echo "  --public      Create a public GitHub repo (default: private)"
    echo "  --ios         Use iOS-specific CLAUDE.md (Swift/SwiftUI/Xcode)"
    echo "  --tracker T   Issue tracker: bd (default) or br"
    echo "                  bd = beads (original): Dolt-backed, richer branching/diff."
    echo "                       Default; pick if you already run Dolt."
    echo "                  br = beads_rust: SQLite + JSONL, single binary, no server."
    echo "                       Pick for zero-infra setups or Docker-only environments."
    echo "                  See README.md \"Picking an Issue Tracker\" for full details."
    echo "  --help        Show this help"
    exit 1
}

if [ $# -lt 1 ]; then
    usage
fi

PROJECT_NAME="$1"
shift

while [ $# -gt 0 ]; do
    case "$1" in
        --workers)
            WORKERS="$2"
            shift 2
            ;;
        --start)
            START=true
            shift
            ;;
        --public)
            PUBLIC=true
            shift
            ;;
        --ios)
            IOS=true
            shift
            ;;
        --tracker)
            TRACKER="$2"
            if [ "$TRACKER" != "br" ] && [ "$TRACKER" != "bd" ]; then
                echo "ERROR: --tracker must be 'br' or 'bd'"
                exit 1
            fi
            shift 2
            ;;
        --help)
            usage
            ;;
        *)
            echo "Unknown option: $1"
            usage
            ;;
    esac
done

PROJECT_DIR="$CODE_DIR/$PROJECT_NAME"

# --- Validate ---

if [ ! -d "$TEMPLATE_REPO" ]; then
    echo "ERROR: Template repo not found at $TEMPLATE_REPO"
    exit 1
fi

if [ -d "$PROJECT_DIR" ]; then
    echo "ERROR: $PROJECT_DIR already exists"
    exit 1
fi

# --- Create project ---

echo "Creating project: $PROJECT_NAME"

git clone "$TEMPLATE_REPO" "$PROJECT_DIR"

cd "$PROJECT_DIR"

# Use iOS template if requested
if [ "$IOS" = true ]; then
    echo "Using iOS CLAUDE.md and settings"
    cp ios/CLAUDE.md CLAUDE.md
    cp ios/.claude/settings.json .claude/settings.json
fi

# Clean up ios/ template directory (not needed in the new project)
rm -rf ios/

# CLAUDE.md and AGENTS.md are written bd-first (the default tracker) —
# only rewrite them when br (beads_rust) was explicitly requested.
if [ "$TRACKER" = "br" ]; then
    echo "Using br (beads_rust) as issue tracker"
    for f in CLAUDE.md AGENTS.md; do
        [ -f "$f" ] || continue

        # Context-specific rewrites first — these consume phrases that the
        # generic word swap below must not also touch. bd (Dolt) and br
        # (SQLite+JSONL) have genuinely different storage/sync models, so
        # these lines can't be produced by a blind word swap.
        sed -i '' 's/The CLI command is `bd`\./The CLI command is `br` (beads_rust)./' "$f"
        sed -i '' 's@run `bd init` first (or `bd bootstrap` — see Syncing below)\.@run `br init` first.@' "$f"
        sed -i '' 's@\*\*Storage\*\*: `bd` uses an embedded.*@**Storage**: `br` uses SQLite locally and JSONL (`.beads/issues.jsonl`) for git-portable storage.@' "$f"
        sed -i '' 's@\*\*Syncing — there is no `bd sync` command\.\*\*.*@**Syncing**: Run `br sync --flush-only` to export to JSONL, then commit `.beads/`. After pulling, run `br sync --import-only`.@' "$f"
        sed -i '' 's@If `bd` is not installed, install it:.*@If `br` is not installed, install it: `curl -fsSL https://raw.githubusercontent.com/Dicklesworthstone/beads_rust/main/install.sh | bash`@' "$f"
        sed -i '' 's/This project can switch to `br`.*/**No external dependencies** — `br` is a self-contained binary. Works the same locally and in Docker./' "$f"
        sed -i '' 's/Publish the bead database: `bd dolt push`/Sync beads to JSONL: `br sync --flush-only`/' "$f"
        sed -i '' 's/`bd dolt push` — publish the bead database\./`br sync --flush-only` — export beads to JSONL./' "$f"
        sed -i '' '/^bd bootstrap.*Fresh clone\/worktree/d' "$f"
        sed -i '' 's/bd dolt pull.*Pull others.*/br sync --import-only       # Import JSONL after git pull/' "$f"
        sed -i '' 's/bd dolt push.*Publish local changes.*/br sync --flush-only        # Export DB to JSONL for git/' "$f"

        # Generic binary-name swap for everything else (bd list, bd ready,
        # bd create, bd show, bd update, bd close, bd dep add, bd init...).
        # BSD sed has no \b — [[:<:]]/[[:>:]] is the real word-boundary syntax.
        sed -i '' 's/[[:<:]]bd[[:>:]]/br/g' "$f"
    done
fi

# Reset git history — fresh start
rm -rf .git
git init
git add -A
git commit -m "Initial commit from claude_starting_repo_setup template"

# Initialize beads if not already done
if [ ! -f ".beads/metadata.json" ]; then
    $TRACKER init
    if [ "$TRACKER" = "br" ]; then
        br sync --flush-only
    fi
    git add .beads/
    git commit -m "Initialize beads workspace"
fi

# --- Create GitHub repo ---

if command -v gh &>/dev/null; then
    VISIBILITY="--private"
    if [ "$PUBLIC" = true ]; then
        VISIBILITY="--public"
    fi

    # Check if repo already exists on GitHub
    if gh repo view "$PROJECT_NAME" &>/dev/null; then
        echo "GitHub repo $PROJECT_NAME already exists. Setting remote and pushing..."
        REPO_URL=$(gh repo view "$PROJECT_NAME" --json url --jq '.url')
        git -C "$PROJECT_DIR" remote add origin "${REPO_URL}.git" 2>/dev/null || true
        git -C "$PROJECT_DIR" push -u origin main --force
    else
        echo "Creating GitHub repo: $PROJECT_NAME ($VISIBILITY)"
        gh repo create "$PROJECT_NAME" $VISIBILITY --source="$PROJECT_DIR"
        git -C "$PROJECT_DIR" push -u origin main
    fi
    echo "Remote set and pushed."
else
    echo "WARNING: gh not found. Create the remote manually:"
    echo "  gh repo create $PROJECT_NAME --private --source=$PROJECT_DIR --push"
fi

echo ""
echo "Project created: $PROJECT_DIR"
echo ""
echo "Next steps:"
echo "  1. Edit $PROJECT_DIR/PROJECT.md with your project details"
echo "  2. Edit $PROJECT_DIR/CLAUDE.md to customize language/framework specifics"
echo "  3. Launch the swarm: swarm-start $PROJECT_DIR --workers $WORKERS"
echo ""

if [ "$START" = true ]; then
    SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
    exec "$SCRIPT_DIR/swarm-start" "$PROJECT_DIR" --workers "$WORKERS"
fi
